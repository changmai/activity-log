# activity_log 설정 템플릿. 복사해서 .env로 쓰고 값을 채운다.
#   cp .env.example .env && chmod 600 .env
# .env는 절대 커밋하지 않는다 (.gitignore + scripts/git-hooks/pre-commit이 차단).

# 기록 API(POST /log) 인증 토큰. 아이폰 단축어·터미널에서 X-Token 헤더로 사용.
# 생성: python3 -c "import secrets; print(secrets.token_hex(16))"
ACTIVITY_TOKEN=

# 브리핑/백업 알림용 텔레그램 봇 토큰 (@BotFather에서 발급)
TELEGRAM_LOG_BOT=

# 브리핑 수신 대화 ID. 비워두면 봇에게 /start 를 보낸 뒤 자동으로 발견해 채운다.
TELEGRAM_CHAT_ID=

# 브리핑 메시지에 넣을 서버 주소 (예: http://100.x.y.z:8787)
TAILSCALE_URL=http://localhost:8787

# claude CLI 실행 파일 경로. 비우면 PATH에서 찾는다.
CLAUDE_BIN=
